# =============================================================================
# Backend environment variables
# Copy this file to src/.env and fill in values.
# NEVER commit src/.env — it is in .gitignore.
#
# All variables are OPTIONAL for local development.
# The application runs fully in mock/simulation mode without any of them.
# =============================================================================

# ---- IBM Bob / watsonx.ai ---------------------------------------------------
# Set all three to switch from mock mode to real IBM Bob API calls.
# Leave any one unset and the system runs its built-in deterministic fallback.
IBM_BOB_API_KEY=your_bob_api_key_here
IBM_BOB_ENDPOINT=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
WATSONX_PROJECT_ID=your_project_id_here

# Granite model to use. Default: ibm/granite-13b-instruct-v2
# Override only if you want to test with a different Granite variant.
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ---- Weather API (optional) -------------------------------------------------
# If unset, the system uses its built-in per-district weather simulator.
# Sign up free at https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# ---- Backend server ---------------------------------------------------------
# Port the uvicorn server binds to. The run command uses --port 8000 directly;
# this variable is available for scripts that read it dynamically.
BACKEND_PORT=8000

# Frontend origin — used if you tighten CORS away from allow_origins=["*"].
# Not needed for local development.
FRONTEND_URL=http://localhost:5173

# ---- Database (NOT USED) ----------------------------------------------------
# This variable is a scaffold placeholder from the project template.
# No database is used in this project — all data is in-memory simulation.
# DATABASE_URL=postgresql://user:password@localhost:5432/grid_outage_db
